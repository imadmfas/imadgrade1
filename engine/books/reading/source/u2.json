     "type": "other",
     "content": [
      {
       "value": "أَصِفُ مَا أُشَاهِدُهُ فِي كُلِّ صُوْرَةٍ.",
       "page": 31
      },
      {
       "value": "لِمَاذَا يَجْتَمِعُ التَّلَامِيْذُ فِي سَاحَةِ الْمَدْرَسَةِ؟",
       "page": 31
      },
      {
       "value": "تَخَيَّلْ نَفْسَكَ فِي هَذِهِ الْغُرْفَةِ الصَّفِّيَّةِ، مَا الأَعْمَالُ الَّتِي تَقُوْمُ بِهَا؟",
       "page": 31
      },
      {
       "value": "قَدِّمْ نَصِيْحَةً لِزَمِيْلِكَ تَحُثُّهُ فِيْهَا عَلَى حُسْنِ التَّعَامُلِ مَعَ الْمُعَلِّمِ وَالزُّمَلَاءِ.",
       "page": 31
      },
      {
       "value": "كَوِّنْ قِصَّةً مِنَ الصُّوَرِ الَّتِي أَمَامَكَ.",
       "page": 31
      }
     ]
    }
